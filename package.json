{
  "name": "vite-console-plugin",
  "version": "2.0.17",
  "description": "Vite 启动台控制台美化与提示插件",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --dts --format cjs,esm",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.3.0"
  },
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "keywords": [
    "vite",
    "vite-plugin",
    "plugin",
    "console",
    "terminal",
    "banner",
    "dev-server",
    "logger",
    "git"
  ],
  "author": "CHENY <ycyplus@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChenyCHENYU/vite-console-plugin.git"
  },
  "homepage": "https://github.com/ChenyCHENYU/vite-console-plugin#readme",
  "bugs": {
    "url": "https://github.com/ChenyCHENYU/vite-console-plugin/issues"
  }
}
